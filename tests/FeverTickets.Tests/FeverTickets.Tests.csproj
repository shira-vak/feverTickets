<!-- Shared settings (target framework, nullable, warnings-as-errors) come from Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FeverTickets\FeverTickets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets every test file use [Fact], Assert, etc. without `using Xunit;` at the top. -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy the saved sample pages next to the test DLL so the tests can read them. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
